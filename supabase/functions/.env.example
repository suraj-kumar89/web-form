# Supabase provides SUPABASE_URL automatically.
# Keep this key ONLY inside Supabase Edge Function secrets.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Resend
RESEND_API_KEY=re_xxxxxxxxx
NOTIFICATION_EMAIL=hello@yourdomain.com
FROM_EMAIL=Bluvo Leads <leads@yourdomain.com>

# Send a confirmation email to the person who submitted the form.
SEND_CUSTOMER_EMAIL=true
